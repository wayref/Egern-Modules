#!name=抖音去广告
#!desc=去开屏广告、信息流推广视频、直播间广告、搜索推广
#!author=QT
#!icon=https://raw.githubusercontent.com/wayref/Egern-Icons/main/Color/Douyin.png

[Rule]
# 穿山甲广告 SDK
DOMAIN-KEYWORD,pangolin,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-dsp-toutiao.com,REJECT

# 广告素材签名域
DOMAIN-KEYWORD,-ad-sign.byteimg.com,REJECT

# 广告 API
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,ad-sg.toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT

# 埋点上报
DOMAIN-SUFFIX,log-api.pangolin-sdk-toutiao.com,REJECT

[URL Rewrite]
# 屏蔽开屏广告接口
^https://.*\.toutiao\.com/api/ad/ - reject
^https://.*\.amemv\.com/api/ad/ - reject

[MITM]
hostname = *.amemv.com

[Script]
# 过滤信息流广告：删除带广告标识的视频
http-response ^https://.*\.amemv\.com/aweme/v\d/feed/.* script-path=https://raw.githubusercontent.com/wayref/Egern-Modules/main/scripts/douyin-filter.js, requires-body=true, timeout=10
http-response ^https://.*\.amemv\.com/aweme/v\d/nearby/feed/.* script-path=https://raw.githubusercontent.com/wayref/Egern-Modules/main/scripts/douyin-filter.js, requires-body=true, timeout=10
